# Copiar a .env y completar. Nunca subir .env al repositorio.
DOMAIN=localhost
POSTGRES_USER=rastrohg
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=rastrohg
JWT_SECRET=generar-con-openssl-rand-hex-32

# Cuenca piloto (minlon,minlat,maxlon,maxlat). Por defecto: Tipuani–Mapiri–Kaká (La Paz)
PILOT_BBOX=-68.8,-15.9,-67.3,-14.3

# Notificaciones: false = se registran en push_outbox pero no se envían (demo local)
PUSH_ENABLED=false

# Fuentes programadas: URL o ruta (/data/raw/...) a GeoJSON/GPKG
# Amazon Mining Watch (Earth Genome, CC-BY 4.0), archivo oficial actualizado trimestralmente:
AMW_URL=https://data.source.coop/earthgenome/amazon-mining-watch/amazon_basin_detections.geojson
# MapBiomas Bolivia clase 30 (minería). Se genera con: uv run rastrohg export-mapbiomas --out ../data/raw/mapbiomas/mapbiomas_mineria.geojson
MAPBIOMAS_URL=/data/raw/mapbiomas/mapbiomas_mineria.geojson

# Google Earth Engine: proyecto de Cloud y (en servidor) JSON de cuenta de servicio montado en el contenedor
EE_PROJECT=
EE_SERVICE_ACCOUNT_KEY=

# Respaldo fuera del VPS con rclone (ej. Backblaze B2)
BACKUP_REMOTE=
# RCLONE_CONFIG_B2_TYPE=b2
# RCLONE_CONFIG_B2_ACCOUNT=
# RCLONE_CONFIG_B2_KEY=

# Chatbot RAG (/v1/chat). Clave en https://platform.openai.com/api-keys. Sin clave, el chat responde
# solo con la pregunta frecuente más parecida y los fragmentos encontrados.
OPENAI_API_KEY=
# RAG_MODEL=gpt-5.4-mini
# RAG_REASONING_EFFORT=low     # dejar vacío si el modelo no es de razonamiento (p. ej. gpt-4.1-mini)
